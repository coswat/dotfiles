[global]
width = 350
origin = top-center
offset = (10, 20)
notification_limit = 5
gap_size = 4
frame_width = 1
padding = 12
horizontal_padding = 12
font = SF Pro Text 13
markup = full
icon_position = left
min_icon_size = 0
max_icon_size = 32
corner_radius = 19
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all
frame_color = "{{ colors.outline.default.hex }}"
highlight = "{{colors.primary.default.hex}}"
separator_color= "{{colors.outline.default.hex}}"

[urgency_low]
timeout = 3
background = "{{colors.surface.default.hex}}70"
foreground = "{{colors.on_surface.default.hex}}"
highlight = "{{colors.primary_container.default.hex}}"

[urgency_normal]
timeout = 6
background = "{{colors.surface.default.hex}}70"
foreground = "{{colors.on_surface.default.hex}}"
highlight = "{{colors.primary_container.default.hex}}"

[urgency_critical]
timeout = 0
background = "{{colors.surface.default.hex}}70"
foreground = "{{colors.on_surface.default.hex}}"
highlight = "{{colors.error.default.hex}}"

